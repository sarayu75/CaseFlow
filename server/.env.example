# Copy this file to .env and fill in real values. Never commit the real
# .env file — it's already excluded in .gitignore.

# PostgreSQL connection string, e.g.:
# postgresql://username:password@localhost:5432/caseflow
DATABASE_URL=

# OpenAI API key, used for case analysis and the AI case search assistant.
OPENAI_API_KEY=

# Port the server listens on (optional, defaults to 5001).
PORT=5001

# Comma-separated list of frontend URLs allowed to call this API.
# Include your local dev URL AND your deployed frontend URL once live.
ALLOWED_ORIGINS=http://localhost:5173